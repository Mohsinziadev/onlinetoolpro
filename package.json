{
  "name": "onlinetoolpro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@latest out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seo:check": "tsx --tsconfig tsconfig.json scripts/gen-lite-catalog.ts --check && tsx --tsconfig tsconfig.json scripts/seo-check.ts",
    "catalog:lite": "tsx --tsconfig tsconfig.json scripts/gen-lite-catalog.ts",
    "predev": "npm run catalog:lite",
    "prebuild": "npm run catalog:lite"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.7",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  }
