# The site is fully static and client-side — no API keys, database or secrets are needed.

# Your production URL. Used for canonical links, the sitemap and social images.
NEXT_PUBLIC_SITE_URL="https://onlinetoolpro.com"

# Optional — defaults to hello@<your site domain>
# NEXT_PUBLIC_CONTACT_EMAIL="hello@onlinetoolpro.com"

# Monetization (all off by default)
# NEXT_PUBLIC_SHOW_AD_SLOTS=true
# NEXT_PUBLIC_AFFILIATES=true
# NEXT_PUBLIC_NEWSLETTER_ACTION="https://your-email-provider.example/subscribe"
